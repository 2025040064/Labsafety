<view class="page">
  <view class="page-heading">
    <text class="demo-mark">模拟数据 · 本机演示</text>
    <text class="page-title">设备详情</text>
    <text class="page-subtitle">查看模拟设备并上报异常</text>
  </view>

  <view wx:if="{{error}}" class="error-state">{{error}}</view>
  <view wx:if="{{loading}}" class="loading-state">正在读取设备…</view>

  <block wx:elif="{{device}}">
    <view class="card">
      <view class="row-top">
        <text class="device-name">{{device.name}}</text>
        <text class="status status--{{device.statusTone}}">{{device.statusText}}</text>
      </view>
      <view class="detail-row"><text class="detail-label">设备编号</text><text class="detail-value">{{device.codeText}}</text></view>
      <view class="detail-row"><text class="detail-label">所在实验室</text><text class="detail-value">{{device.labText}}</text></view>
      <view class="detail-row"><text class="detail-label">型号</text><text class="detail-value">{{device.modelText}}</text></view>
    </view>

    <view class="card">
      <text class="section-title">设备管理</text>
      <text class="muted">停用后设备只读，不能再上报异常或提交巡检；演示数据可在首页重置。</text>
      <text wx:if="{{!canManage}}" class="muted">设备编辑与停用/启用仅限演示管理员；角色切换只是本机演示规则。</text>
      <block wx:if="{{editForm}}">
        <view class="manage-form">
          <text class="field-label">设备编号</text>
          <input class="field-input" value="{{editForm.code}}" maxlength="20" placeholder="2-20 位字母、数字或连字符" data-field="code" bindinput="onEditInput" />
          <text class="field-label">名称</text>
          <input class="field-input" value="{{editForm.name}}" maxlength="40" placeholder="2 至 40 字" data-field="name" bindinput="onEditInput" />
          <text class="field-label">型号</text>
          <input class="field-input" value="{{editForm.model}}" maxlength="40" placeholder="不超过 40 字" data-field="model" bindinput="onEditInput" />
          <view class="manage-actions">
            <button class="plain-button" size="mini" bindtap="cancelEdit" disabled="{{submitting}}">取消</button>
            <button class="primary-button" size="mini" loading="{{submitting}}" disabled="{{submitting}}" bindtap="saveEdit">保存修改</button>
          </view>
        </view>
      </block>
      <view wx:elif="{{device.isActive && canManage}}" class="manage-actions">
        <button class="plain-button" size="mini" bindtap="startEdit" disabled="{{submitting}}">编辑信息</button>
        <button class="plain-button danger-plain" size="mini" bindtap="toggleActive" disabled="{{submitting}}">停用设备</button>
      </view>
      <view wx:elif="{{!device.isActive && canManage}}" class="manage-actions">
        <button class="plain-button" size="mini" bindtap="toggleActive" disabled="{{submitting}}">恢复启用</button>
      </view>
    </view>

    <view class="card">
      <text class="section-title">上报模拟异常</text>
      <text class="muted">提交后会生成本机演示记录和时间线，不会发送给真实实验室。</text>
      <view wx:if="{{!device.isActive}}" class="empty-state inactive-note">此设备当前不可上报异常。</view>
      <block wx:else>
        <text class="field-label">异常标题</text>
        <input class="field-input" value="{{title}}" maxlength="80" placeholder="如：模拟温度显示异常" bindinput="onTitleInput" />

        <text class="field-label">现象描述</text>
        <textarea class="field-textarea" value="{{description}}" maxlength="1000" placeholder="描述观察到的模拟异常现象" bindinput="onDescriptionInput" />

        <text class="field-label">严重度</text>
        <picker mode="selector" range="{{severityChoices}}" range-key="label" value="{{severityIndex}}" bindchange="onSeverityChange">
          <view class="picker-box">{{severityChoices[severityIndex].label}} <text class="picker-arrow">⌄</text></view>
        </picker>

        <button class="primary-button submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="reportIncident">提交模拟异常</button>
      </block>
    </view>
  </block>
</view>
