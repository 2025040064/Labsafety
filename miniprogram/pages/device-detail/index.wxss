.device-name {
  font-size: 35rpx;
  font-weight: 700;
  color: #17343d;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  column-gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f2;
}

.detail-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.detail-label {
  color: #6b7d82;
  font-size: 24rpx;
}

.detail-value {
  flex: 1;
  text-align: right;
  color: #28444d;
  font-size: 24rpx;
  overflow-wrap: anywhere;
}

.field-label {
  display: block;
  color: #294850;
  font-size: 25rpx;
  font-weight: 600;
  margin: 25rpx 0 10rpx;
}

.field-input,
.field-textarea,
.picker-box {
  box-sizing: border-box;
  width: 100%;
  background: #f5f8f8;
  border: 1rpx solid #dbe6e7;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #17343d;
}

.field-input,
.picker-box {
  min-height: 78rpx;
  padding: 16rpx 20rpx;
}

.field-textarea {
  height: 180rpx;
  padding: 16rpx 20rpx;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #789093;
  font-size: 30rpx;
}

.submit-button {
  margin-top: 30rpx;
}

.inactive-note {
  margin-top: 22rpx;
}

.manage-actions {
  display: flex;
  column-gap: 18rpx;
  margin-top: 24rpx;
}

.manage-form {
  margin-top: 20rpx;
  padding-top: 4rpx;
  border-top: 1rpx dashed #d5e1e3;
}

.danger-plain {
  color: #a13d31;
  border-color: #e4b3aa;
}
