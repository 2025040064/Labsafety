.incident-title {
  font-size: 33rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 17rpx 0;
  border-bottom: 1rpx solid #edf1f2;
}

.detail-label {
  color: #6b7d82;
  font-size: 24rpx;
}

.detail-value {
  color: #294850;
  font-size: 24rpx;
}

.description-label {
  display: block;
  color: #6b7d82;
  font-size: 24rpx;
  margin-top: 22rpx;
}

.description {
  display: block;
  color: #294850;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 8rpx;
  white-space: pre-wrap;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  column-gap: 18rpx;
  row-gap: 16rpx;
  margin-top: 22rpx;
}

.action-button {
  flex: 1;
  min-width: 180rpx;
}

.action-button--danger {
  color: #a13d31;
  border-color: #e4b3aa;
}

.pending-panel {
  margin-top: 26rpx;
  padding-top: 4rpx;
  border-top: 1rpx dashed #d5e1e3;
}

.reason-textarea {
  height: 150rpx;
}

.action-empty {
  margin-top: 22rpx;
}

.attachment-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f2;
}

.attachment-row:last-child {
  border-bottom: 0;
}

.attachment-exists {
  display: block;
  color: #0b6a5f;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.attachment-exists--bad {
  color: #a13d31;
}

.field-label {
  display: block;
  color: #294850;
  font-size: 25rpx;
  font-weight: 600;
  margin: 25rpx 0 10rpx;
}

.field-textarea {
  box-sizing: border-box;
  width: 100%;
  background: #f5f8f8;
  border: 1rpx solid #dbe6e7;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #17343d;
  padding: 16rpx 20rpx;
}

.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 30rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 24rpx;
  bottom: -1rpx;
  border-left: 2rpx solid #c8dfd9;
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  flex: none;
  position: relative;
  z-index: 1;
  width: 23rpx;
  height: 23rpx;
  margin-top: 7rpx;
  border-radius: 50%;
  background: #08796d;
  border: 4rpx solid #d8eee8;
  box-sizing: border-box;
}

.timeline-content {
  flex: 1;
  padding-left: 20rpx;
}

.event-action {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
}

.event-meta,
.event-transition,
.event-reason {
  display: block;
  color: #6a7e82;
  font-size: 23rpx;
  margin-top: 4rpx;
}

.event-transition {
  color: #08796d;
}
