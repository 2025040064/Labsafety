.device-row {
  min-height: 100rpx;
}

.entry-hint {
  display: block;
  color: #08796d;
  font-size: 22rpx;
  margin-top: 13rpx;
}

.manage-title {
  margin-bottom: 0;
}

.manage-toggle {
  flex: none;
}

.manage-lab-row {
  display: flex;
  align-items: center;
  column-gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1f2;
}

.manage-lab-row:last-of-type {
  border-bottom: 0;
}

.manage-mini {
  font-size: 23rpx;
  padding: 0 22rpx;
  min-height: 60rpx;
  line-height: 58rpx;
}

.manage-actions {
  display: flex;
  column-gap: 18rpx;
  margin-top: 22rpx;
}

.manage-form {
  margin-top: 26rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #d5e1e3;
}

.manage-form-title {
  margin-top: 14rpx;
}

.field-label {
  display: block;
  color: #294850;
  font-size: 25rpx;
  font-weight: 600;
  margin: 22rpx 0 10rpx;
}

.field-input,
.picker-box {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 15rpx 20rpx;
  background: #f5f8f8;
  border: 1rpx solid #dbe6e7;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #17343d;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #789093;
  font-size: 30rpx;
}
