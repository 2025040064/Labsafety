<view class="page">
  <view class="page-heading">
    <text class="demo-mark">模拟数据 · 本机演示</text>
    <text class="page-title">设备台账</text>
    <text class="page-subtitle">点击设备查看信息并上报模拟异常</text>
  </view>

  <view wx:if="{{error}}" class="error-state">{{error}}</view>
  <view wx:if="{{loading}}" class="loading-state">正在读取设备…</view>
  <view wx:elif="{{devices.length === 0}}" class="empty-state">暂无设备记录。可在首页恢复固定模拟数据。</view>
  <view wx:else class="card">
    <view wx:for="{{devices}}" wx:key="id" class="item-row device-row" data-id="{{item.id}}" bindtap="openDevice">
      <view class="row-top">
        <view class="row-main">
          <text class="item-title">{{item.name}}</text>
          <text class="item-meta">编号 {{item.codeText}} · {{item.labText}}</text>
        </view>
        <text class="status status--{{item.statusTone}}">{{item.statusText}}</text>
      </view>
      <text class="entry-hint">查看详情 ›</text>
    </view>
  </view>

  <view class="card">
    <view class="row-top">
      <text class="section-title manage-title">台账管理</text>
      <button wx:if="{{canManage}}" class="plain-button manage-toggle" size="mini" bindtap="toggleManaging">{{managing ? '收起' : '展开'}}</button>
    </view>
    <text class="muted">实验室与设备均可编辑，编号在本机唯一；停用设备后只读。仅为本机演示数据。</text>
    <text wx:if="{{!canManage}}" class="muted">台账编辑仅限演示管理员；角色切换可在首页进行，只是本机演示规则。</text>
    <block wx:if="{{managing}}">
      <view wx:for="{{labs}}" wx:key="id" class="manage-lab-row">
        <view class="row-main">
          <text class="item-title">{{item.name}}</text>
          <text class="item-meta">编号 {{item.code}}{{item.location ? ' · ' + item.location : ''}} · {{item.deviceCount}} 台设备</text>
        </view>
        <button class="plain-button manage-mini" size="mini" data-id="{{item.id}}" bindtap="startEditLab">编辑</button>
      </view>
      <view class="manage-actions">
        <button class="plain-button manage-mini" size="mini" bindtap="startCreateLab">+ 新增实验室</button>
        <button class="plain-button manage-mini" size="mini" bindtap="startCreateDevice" disabled="{{deviceLabOptions.length === 0}}">+ 登记设备</button>
      </view>

      <view wx:if="{{labForm}}" class="manage-form">
        <text class="section-title manage-form-title">{{labForm.labId ? '编辑实验室' : '新增实验室'}}</text>
        <text class="field-label">实验室编号</text>
        <input class="field-input" value="{{labForm.code}}" maxlength="20" placeholder="2-20 位字母、数字或连字符" data-field="code" bindinput="onLabFormInput" />
        <text class="field-label">名称</text>
        <input class="field-input" value="{{labForm.name}}" maxlength="40" placeholder="2 至 40 字" data-field="name" bindinput="onLabFormInput" />
        <text class="field-label">位置（可选）</text>
        <input class="field-input" value="{{labForm.location}}" maxlength="60" placeholder="不超过 60 字" data-field="location" bindinput="onLabFormInput" />
        <view class="manage-actions">
          <button class="plain-button manage-mini" size="mini" bindtap="cancelLabForm" disabled="{{submitting}}">取消</button>
          <button class="primary-button manage-mini" size="mini" loading="{{submitting}}" disabled="{{submitting}}" bindtap="saveLabForm">{{labForm.labId ? '保存修改' : '创建实验室'}}</button>
        </view>
      </view>

      <view wx:if="{{deviceForm}}" class="manage-form">
        <text class="section-title manage-form-title">登记设备</text>
        <text class="field-label">所属实验室</text>
        <picker mode="selector" range="{{deviceLabOptions}}" value="{{deviceForm.labIndex}}" bindchange="onDeviceLabChange">
          <view class="picker-box">{{deviceLabOptions[deviceForm.labIndex]}} <text class="picker-arrow">⌄</text></view>
        </picker>
        <text class="field-label">设备编号</text>
        <input class="field-input" value="{{deviceForm.code}}" maxlength="20" placeholder="2-20 位字母、数字或连字符" data-field="code" bindinput="onDeviceFormInput" />
        <text class="field-label">名称</text>
        <input class="field-input" value="{{deviceForm.name}}" maxlength="40" placeholder="2 至 40 字" data-field="name" bindinput="onDeviceFormInput" />
        <text class="field-label">型号（可选）</text>
        <input class="field-input" value="{{deviceForm.model}}" maxlength="40" placeholder="不超过 40 字" data-field="model" bindinput="onDeviceFormInput" />
        <view class="manage-actions">
          <button class="plain-button manage-mini" size="mini" bindtap="cancelDeviceForm" disabled="{{submitting}}">取消</button>
          <button class="primary-button manage-mini" size="mini" loading="{{submitting}}" disabled="{{submitting}}" bindtap="saveDeviceForm">登记设备</button>
        </view>
      </view>
    </block>
    <block wx:elif="{{canManage}}">
      <view class="empty-state manage-empty">点击“展开”后可新增/编辑实验室与登记设备。</view>
    </block>
  </view>
</view>
