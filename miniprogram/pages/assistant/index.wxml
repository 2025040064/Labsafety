<view class="page">
  <view class="page-heading">
    <text class="demo-mark">本地规则 · 本机演示</text>
    <text class="page-title">填报助手</text>
    <text class="page-subtitle">关键词规则生成可编辑草稿，确认后才写入</text>
  </view>

  <view class="card intro-card">
    <text class="muted">本页使用本机关键词规则解析文字并生成草稿，不是语义理解，也不是大模型 AI。解析不会写入任何数据；补全字段并确认后，才会调用与工作台相同的业务命令。</text>
  </view>

  <view class="card">
    <text class="section-title">描述你的需求</text>
    <textarea class="field-textarea" value="{{text}}" maxlength="1000" placeholder="例：SIM-DEV-001 通风柜风速偏低，疑似故障&#10;或：巡检 SIM-DEV-002" bindinput="onTextInput" />
    <view class="draft-actions">
      <button class="plain-button" size="mini" bindtap="clearDraft" disabled="{{submitting}}">清空</button>
      <button class="primary-button" size="mini" loading="{{parsing}}" disabled="{{parsing}}" bindtap="parseDraft">解析草稿</button>
    </view>
  </view>

  <view wx:if="{{error}}" class="error-state">{{error}}</view>

  <block wx:if="{{parsed}}">
    <view wx:if="{{intent === 'UNKNOWN'}}" class="empty-state">{{parsed.message}}</view>

    <view wx:if="{{missing.length > 0 && intent !== 'UNKNOWN'}}" class="card missing-card">
      <text class="section-title">草稿未提交：还缺以下字段</text>
      <text wx:for="{{missing}}" wx:key="*this" class="missing-item">· {{item}}</text>
      <text class="muted">补充后重新解析，或直接在下方修改草稿；缺失字段不会被自动补写。</text>
    </view>

    <view wx:if="{{intent === 'INCIDENT'}}" class="card">
      <text class="section-title">异常草稿（可编辑）</text>
      <text class="field-label">设备</text>
      <picker mode="selector" range="{{devices}}" range-key="labelText" value="{{deviceIndex < 0 ? 0 : deviceIndex}}" bindchange="onDraftDeviceChange">
        <view class="picker-box">{{deviceIndex < 0 ? '请选择设备' : devices[deviceIndex].labelText}} <text class="picker-arrow">⌄</text></view>
      </picker>
      <text class="field-label">异常标题</text>
      <input class="field-input" value="{{title}}" maxlength="80" placeholder="2 至 80 字" bindinput="onDraftTitleInput" />
      <text class="field-label">严重度</text>
      <picker mode="selector" range="{{severityChoices}}" range-key="label" value="{{severityIndex}}" bindchange="onDraftSeverityChange">
        <view class="picker-box">{{severityChoices[severityIndex].label}} <text class="picker-arrow">⌄</text></view>
      </picker>
      <text class="field-label">现象描述</text>
      <textarea class="field-textarea field-textarea--short" value="{{description}}" maxlength="1000" placeholder="不超过 1000 字" bindinput="onDraftDescriptionInput" />
      <button class="primary-button submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitDraft">确认并上报异常</button>
    </view>

    <view wx:if="{{intent === 'INSPECTION'}}" class="card">
      <text class="section-title">巡检草稿（可编辑）</text>
      <text class="field-label">巡检模板</text>
      <picker mode="selector" range="{{templates}}" range-key="title" value="{{templateIndex < 0 ? 0 : templateIndex}}" bindchange="onDraftTemplateChange">
        <view class="picker-box">{{templateIndex < 0 ? '请选择模板' : templates[templateIndex].title}} <text class="picker-arrow">⌄</text></view>
      </picker>
      <text class="field-label">巡检设备</text>
      <picker mode="selector" range="{{devices}}" range-key="labelText" value="{{deviceIndex < 0 ? 0 : deviceIndex}}" bindchange="onDraftDeviceChange">
        <view class="picker-box">{{deviceIndex < 0 ? '请选择设备' : devices[deviceIndex].labelText}} <text class="picker-arrow">⌄</text></view>
      </picker>
      <view wx:for="{{items}}" wx:key="item" class="check-item">
        <view class="row-top">
          <text class="check-title">{{index + 1}}. {{item.item}}</text>
          <switch checked="{{item.passed}}" data-index="{{index}}" bindchange="onDraftItemPassedChange" color="#08796d" />
        </view>
        <input class="field-input check-note" value="{{item.note}}" maxlength="500" placeholder="备注（可选）" data-index="{{index}}" bindinput="onDraftItemNoteInput" />
      </view>
      <button class="primary-button submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitDraft">确认并提交巡检</button>
    </view>
  </block>

  <view wx:if="{{!parsed}}" class="empty-state">解析结果会显示在这里。草稿与保存分离：未确认的草稿不会生成本机记录。</view>
</view>
