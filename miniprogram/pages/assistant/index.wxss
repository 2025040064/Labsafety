.intro-card {
  background: #e8f4f0;
  border-color: #c8e3d9;
}

.field-textarea {
  box-sizing: border-box;
  width: 100%;
  height: 180rpx;
  padding: 16rpx 20rpx;
  background: #f5f8f8;
  border: 1rpx solid #dbe6e7;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #17343d;
}

.field-textarea--short {
  height: 150rpx;
}

.field-label {
  display: block;
  color: #294850;
  font-size: 25rpx;
  font-weight: 600;
  margin: 24rpx 0 10rpx;
}

.field-input,
.picker-box {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 15rpx 20rpx;
  background: #f5f8f8;
  border: 1rpx solid #dbe6e7;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #17343d;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #789093;
  font-size: 30rpx;
}

.draft-actions {
  display: flex;
  justify-content: flex-end;
  column-gap: 18rpx;
  margin-top: 24rpx;
}

.missing-card {
  border-color: #e7cfa4;
  background: #fffaf0;
}

.missing-item {
  display: block;
  color: #8a5a17;
  font-size: 25rpx;
  line-height: 1.7;
}

.missing-card .muted {
  display: block;
  margin-top: 12rpx;
}

.check-item {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e0e9ea;
}

.check-title {
  flex: 1;
  font-size: 27rpx;
  font-weight: 600;
  color: #234650;
}

.check-note {
  margin-top: 14rpx;
}

.submit-button {
  margin-top: 30rpx;
}
