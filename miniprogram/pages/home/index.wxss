.hero {
  background: #102d3c;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.hero .demo-mark {
  background: rgba(112, 213, 179, 0.16);
  border-color: rgba(112, 213, 179, 0.5);
  color: #a8e7d2;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-subtitle {
  display: block;
  color: #cde4e4;
  font-size: 28rpx;
  margin-top: 10rpx;
}

.hero-note {
  display: block;
  color: #afc9cd;
  font-size: 23rpx;
  margin-top: 22rpx;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.stat {
  width: calc(50% - 16rpx);
  box-sizing: border-box;
  margin: 8rpx;
  padding: 21rpx 20rpx;
  border-radius: 14rpx;
  background: #f4f8f7;
}

.stat-value {
  display: block;
  color: #096b62;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stat-label {
  display: block;
  color: #647b7c;
  font-size: 23rpx;
  margin-top: 8rpx;
}

.role-options {
  display: flex;
  column-gap: 12rpx;
  margin-top: 22rpx;
}

.role-button {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0 4rpx;
  border-radius: 12rpx;
  background: #f2f6f6;
  color: #536d72;
  border: 1rpx solid #dce6e6;
  font-size: 25rpx;
}

.role-button::after {
  border: 0;
}

.role-button--active {
  background: #e1f2ee;
  border-color: #6dbbab;
  color: #08796d;
  font-weight: 700;
}

.flow {
  display: block;
  color: #206860;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 13rpx;
}

.reset-button {
  margin-top: 20rpx;
}

.backup-actions {
  display: flex;
  column-gap: 18rpx;
  margin-top: 22rpx;
}

.backup-report {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #d5e1e3;
}

.backup-line {
  display: block;
  color: #3f5a62;
  font-size: 23rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.backup-warn {
  display: block;
  color: #8a5a17;
  font-size: 23rpx;
  line-height: 1.7;
  margin-top: 6rpx;
}

.field-label {
  display: block;
  color: #294850;
  font-size: 25rpx;
  font-weight: 600;
  margin: 26rpx 0 10rpx;
}

.import-textarea {
  box-sizing: border-box;
  width: 100%;
  height: 200rpx;
  padding: 16rpx 20rpx;
  background: #f5f8f8;
  border: 1rpx solid #dbe6e7;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #17343d;
  overflow-wrap: anywhere;
}
