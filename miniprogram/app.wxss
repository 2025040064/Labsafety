page {
  background: #f4f7f8;
  color: #17343d;
  font-size: 28rpx;
  line-height: 1.5;
}

button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.page-heading {
  margin-bottom: 28rpx;
}

.page-title {
  display: block;
  font-size: 43rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.page-subtitle {
  display: block;
  color: #62777d;
  font-size: 25rpx;
  margin-top: 8rpx;
}

.demo-mark {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e1f2ee;
  color: #086d62;
  border: 1rpx solid #a4d5c8;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.card {
  background: #fff;
  border: 1rpx solid #e2e9eb;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 28rpx rgba(18, 54, 65, 0.04);
}

.section-title {
  display: block;
  color: #234650;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.muted {
  color: #6f8085;
  font-size: 24rpx;
}

.item-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1f2;
}

.item-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.item-title {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: #17343d;
  line-height: 1.35;
}

.item-meta {
  display: block;
  color: #697c82;
  font-size: 23rpx;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}

.row-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  column-gap: 14rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.status {
  flex: none;
  display: inline-block;
  padding: 5rpx 13rpx;
  border-radius: 999rpx;
  background: #e9eff1;
  color: #48636b;
  font-size: 21rpx;
  line-height: 1.5;
}

.status--good {
  background: #e1f2ee;
  color: #08796d;
}

.status--warn {
  background: #fff1d8;
  color: #986016;
}

.status--danger {
  background: #fde9e6;
  color: #b74737;
}

.empty-state,
.error-state,
.loading-state {
  border-radius: 16rpx;
  padding: 30rpx 26rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.empty-state {
  background: #fff;
  border: 1rpx dashed #c8d5d8;
  color: #71848a;
}

.error-state {
  background: #fff0ed;
  border: 1rpx solid #f1ccc4;
  color: #a13d31;
  margin-bottom: 20rpx;
}

.loading-state {
  color: #61787e;
  text-align: center;
}

.primary-button {
  background: #08796d;
  color: #fff;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
  margin: 0;
}

.primary-button::after {
  border: 0;
}

.plain-button {
  background: #fff;
  color: #21645d;
  border: 1rpx solid #99c9be;
  border-radius: 14rpx;
  font-size: 26rpx;
  margin: 0;
}

.plain-button::after {
  border: 0;
}
